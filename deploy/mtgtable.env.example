# /etc/mtgtable/mtgtable.env に置く（chmod 600、所有者 mtgtable）。キーをリポジトリに入れない
MTGTABLE_DB=/var/lib/mtgtable/mtg.sqlite
MTG_CARDS_DIR=/var/lib/mtgtable/cards

# 利用規約・プライバシーの画面に出る運営者と連絡先
MTGTABLE_OPERATOR=
MTGTABLE_CONTACT=

# AI の提供元とキー（secrets/README.md）。どちらか（両方でもよい）
MTGTABLE_LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# AI の利用の上限（トークンは入力（キャッシュ分を含む）＋出力）
MTGTABLE_AI_CALLS_PER_GAME=600
MTGTABLE_AI_TOKENS_PER_GAME=6000000
MTGTABLE_AI_TOKENS_PER_OWNER_DAY=10000000
MTGTABLE_AI_TOKENS_PER_DAY=100000000

# レート制限を変えるとき（回数/秒）。例: MTGTABLE_RATE_WRITE=120/60
# 空きがこれより減ると /healthz が 503
MTGTABLE_MIN_FREE_MB=500
PYTHONIOENCODING=utf-8
